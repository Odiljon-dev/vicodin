<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<body>
  <div class="login-container">
    <form class="login-form" action="/admin/login" method="POST">
      <div class="login-frame">
        <div class="login-top">
          <h1 class="login-title">Login</h1>
          <div class="login-links">
            <span>Go back <a href="/admin" class="link-accent">Home</a></span>
            <span>Not registered yet? <a href="/admin/signup" class="link-accent">Signup</a></span>
          </div>
        </div>
        <div class="login-input-frame">
          <div class="login-input-container">
            <label>Seller *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Username"
              value=""
              required
            />
          </div>
          <div class="login-input-container">
            <label>Password *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              value=""
              required
            />
          </div>
        </div>
        <button class="login-btn" name="login" type="submit">Login</button>
      </div>
    </form>
  </div>
</body>

<%- include('includes/footer') %>
