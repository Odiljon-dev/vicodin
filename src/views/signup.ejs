<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<body>
  <div class="signup-container">
    <form
      class="signup-form"
      onsubmit="return validateSignupForm();"
      action="/admin/signup"
      method="POST"
      enctype="multipart/form-data"
    >
      <div class="signup-frame">
        <div class="signup-top">
          <h1 class="signup-title">Signup</h1>
          <div class="signup-links">
            <span>Go back <a href="/admin" class="link-accent">Home</a></span>
            <span>Already signed up? <a href="/admin/login" class="link-accent">Login</a></span>
          </div>
        </div>

        <div class="sign-input-frame">
          <div class="sign-up-frame">
            <label>Seller *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Username"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label>Phone *</label>
            <input
              type="text"
              name="memberPhone"
              class="member-phone"
              placeholder="Phone"
              value=""
            />
          </div>
        </div>
        <div class="sign-input-frame">
          <div class="sign-up-frame">
            <label>Password *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label>Repeat password *</label>
            <input
              type="password"
              name="confirmPassword"
              class="confirm-password"
              placeholder="Repeat password"
              value=""
            />
          </div>
        </div>

        <div class="signup-input-frame">
          <div class="media-frame">
            <img class="upload-img-frame" src="/img/default.jpeg" />
            <div class="upload-container">
              <span class="media-text">Product image</span>
              <div class="file-box preview-image">
                <input
                  class="upload-name"
                  value="Choose image"
                  disabled="disabled"
                />
                <label for="input-file" class="file-input-label">Choose Image</label>
                <input
                  type="file"
                  id="input-file"
                  class="upload-hidden form-control-file member-image"
                  name="memberImage"
                />
              </div>
              <p class="thumbnail-desc">
                Please upload pharmacy / store image.<br />
                Allowed formats: .jpg, .jpeg, .png
              </p>
            </div>
          </div>
        </div>

        <input name="memberType" value="SELLER" hidden />

        <button class="signup-btn" name="signup" type="submit">
          Create Account
        </button>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
